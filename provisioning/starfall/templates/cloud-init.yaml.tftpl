#cloud-config
hostname: ${vm_name}
timezone: ${timezone}

disable_root: false
ssh_pwauth: true

packages:
  - openssh-server
  - ncurses
  - vim-enhanced
  - tar
  - bash-completion
  - less
  - net-tools

runcmd:
  - sed -i '1i PermitRootLogin yes\nPasswordAuthentication yes' /etc/ssh/sshd_config
  - echo 'root:${root_password}' | chpasswd
  - passwd -u root
  - systemctl enable --now sshd
  - systemctl restart sshd
